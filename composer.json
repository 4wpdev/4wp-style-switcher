{
	"name": "4wp-dev/4wp-style-switcher",
	"description": "4WP Theme Style Switcher — theme.json style variations per page and visitor Light/Dark toggle (FSE).",
	"type": "wordpress-plugin",
	"version": "0.2.1",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"ForWP\\StyleSwitcher\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"ForWP\\StyleSwitcher\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"test": "phpunit"
	}
}
